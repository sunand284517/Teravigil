{
  "name": "terravigil-workspace",
  "version": "3.0.0",
  "private": true,
  "description": "TerraVigil integrated model inference, mission RAG and PDF/CSV reporting",
  "scripts": {
    "start": "node scripts/start.cjs",
    "setup": "node scripts/setup.cjs",
    "setup:model": "node scripts/setup.cjs --model-only",
    "setup:dev": "node scripts/setup.cjs --dev",
    "doctor": "node scripts/doctor.cjs",
    "build": "npm --prefix frontend run build",
    "test": "npm --prefix backend test && npm --prefix frontend test",
    "test:sample": "node --test backend/test/simulation.test.cjs"
  },
  "engines": {
    "node": ">=22.12.0 <23 || >=24.0.0 <25"
  }
}
