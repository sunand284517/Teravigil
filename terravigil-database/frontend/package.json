{
  "name": "terravigil-frontend",
  "private": true,
  "version": "2.2.0",
  "type": "module",
  "description": "TerraVigil \u2014 aerial survey intelligence workspace with explicit demo and live adapters.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build --mode sample",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:copy": "node scripts/check-copy.mjs",
    "check:contrast": "node scripts/contrast-audit.mjs",
    "validate": "npm run typecheck && npm run lint && npm run test && npm run check:boundaries && npm run check:tokens && npm run check:copy && npm run check:contrast && npm run build",
    "demo": "vite --mode demo",
    "build:demo": "tsc --noEmit && vite build --mode demo --outDir dist-demo",
    "preview:demo": "node scripts/serve-preview.mjs dist-demo",
    "build:standalone": "node scripts/build-standalone.mjs",
    "start": "node ../scripts/start.cjs",
    "check:gemini": "node ../backend/scripts/check-gemini.cjs",
    "build:all": "npm run build && npm run build:demo && npm run build:standalone && npm run check:artifacts",
    "check:artifacts": "node scripts/check-artifacts.mjs && node scripts/check-standalone.mjs",
    "build:live": "tsc --noEmit && vite build --mode production --outDir dist-live",
    "build:sample-service": "node scripts/build-sample-service.mjs",
    "predev": "npm run build:sample-service",
    "predemo": "npm run build:sample-service",
    "prebuild": "npm run build:sample-service",
    "prebuild:demo": "npm run build:sample-service",
    "prebuild:standalone": "npm run build:sample-service",
    "pretest": "npm run build:sample-service"
  },
  "dependencies": {
    "@fontsource-variable/inter-tight": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@tanstack/react-query": "5.102.2",
    "gsap": "3.13.0",
    "leaflet": "1.9.4",
    "lucide-react": "1.33.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "5.0.0",
    "react-router-dom": "7.18.2",
    "recharts": "3.10.1",
    "socket.io-client": "^4.8.3",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.22",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "10.5.4",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "jsdom": "26.1.0",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
