# Local compiled live preview. Override public settings in .env.production.local
# before building for another environment. Never put backend secrets here.
VITE_DATA_MODE=live
VITE_BACKEND_STYLE=missions
VITE_API_BASE_URL=/api
VITE_WS_URL=
VITE_REQUEST_TIMEOUT_MS=15000
VITE_ASSISTANT_TIMEOUT_MS=65000
VITE_PREPARATION_TIMEOUT_MS=190000

# Public basemap requires internet; leave empty to use the offline grid.
VITE_TILE_URL=https://services.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
VITE_TILE_ATTRIBUTION=Tiles &copy; <a href="https://www.esri.com/">Esri</a> — Source: Esri, Maxar, Earthstar Geographics, and the GIS User Community
VITE_TILE_MAX_NATIVE_ZOOM=19
