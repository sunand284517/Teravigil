# TerraVigil frontend environment template.
# Copy to .env.development.local to override local development. No secrets belong here.

# Live development and production use the supplied Express mission contract.
VITE_DATA_MODE=live
VITE_BACKEND_STYLE=missions

# Run root npm start for the integrated backend. Relative /api uses the current origin
# and Vite proxies it in development. Backend failures are surfaced directly.
VITE_API_BASE_URL=/api

# The supplied Express backend has no WebSocket. Mission REST data refreshes
# every 5 seconds while relevant pages are active.
VITE_WS_URL=

# Optional. Timeout for REST reads, in milliseconds. Default 15000.
VITE_REQUEST_TIMEOUT_MS=15000

# RAG requests can warm the local MiniLM model or wait for Gemini on first use.
# Defaults: assistant 65000 ms, preparation 190000 ms.
VITE_ASSISTANT_TIMEOUT_MS=65000
VITE_PREPARATION_TIMEOUT_MS=190000

# Satellite imagery is the default. It needs internet.
# Set VITE_TILE_URL= explicitly to select the offline grid.
# Alternatively use a licensed local tile source, for example:
# VITE_TILE_URL=http://localhost:8080/tiles/{z}/{x}/{y}.png
VITE_TILE_URL=https://services.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
VITE_TILE_ATTRIBUTION=Tiles &copy; Esri — Esri, Maxar, Earthstar Geographics, and the GIS User Community
# Highest zoom supplied by your dataset; higher display zooms reuse these tiles.
VITE_TILE_MAX_NATIVE_ZOOM=19
