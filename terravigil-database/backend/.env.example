# Copy this file to .env on the backend host. Keep the key private.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
RAG_TOP_K=3
RAG_MIN_SCORE=0.30
RAG_GENERATION_TIMEOUT_MS=45000
RAG_INDEX_TIMEOUT_MS=180000

# Local persistent storage is the default. No MongoDB setup is required.
TERRAVIGIL_DB=local
# Optional alternative: TERRAVIGIL_DB=mongodb
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=terravigil
# Optional absolute folder. Default: backend/data
TERRAVIGIL_DATA_DIR=
PORT=3000

# Setup creates a project .venv, which is discovered automatically.
# Optional absolute path to another configured Python executable:
INFERENCE_PYTHON=
INFERENCE_DEVICE=cpu
INFERENCE_TIMEOUT_MS=120000
INFERENCE_STATUS_TIMEOUT_MS=45000
